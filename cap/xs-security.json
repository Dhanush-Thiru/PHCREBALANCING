    { "name": "$XSAPPNAME.CMO", "description": "View operations and decide controlled medicine transfers" }
  ],
  "role-templates": [
    { "name": "PHC_MEDICAL_OFFICER", "description": "Primary Health Centre medical officer", "scope-references": ["$XSAPPNAME.PHC_MEDICAL_OFFICER"] },
