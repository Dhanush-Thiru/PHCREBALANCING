  ],
  "role-collections": [
    { "name": "PHC Medical Officer", "description": "PHC operational role", "role-template-references": ["$XSAPPNAME.PHC_MEDICAL_OFFICER"] },
    { "name": "District CMO", "description": "District approval role", "role-template-references": ["$XSAPPNAME.CMO"] }
  ]
}
